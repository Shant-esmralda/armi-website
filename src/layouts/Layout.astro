---
import '../styles/global.css';
import { withBase } from '../utils/paths';
import Icon from '../components/Icon.astro';
import { artist, homeCopy, homePath, languageNames, locales, type Locale } from '../i18n/home';
import { contactPath } from '../i18n/contact';
import { aboutPath, resourcesPath, libraryCopy } from '../i18n/library';
interface Props {
  locale: Locale;
  page?: 'home' | 'contact' | 'about' | 'resources';
  title?: string;
  description?: string;
}
const { locale, page = 'home', title, description } = Astro.props;
const copy = homeCopy[locale];
const pageTitle = title ?? copy.title;
const pageDescription = description ?? copy.description;
const pagePaths = { home: homePath, contact: contactPath, about: aboutPath, resources: resourcesPath };
const pagePath = pagePaths[page];
const links = [
  { label: copy.home, href: homePath(locale), current: page === 'home' },
  { label: libraryCopy[locale].about, href: aboutPath(locale), current: page === 'about' },
  { label: copy.resources, href: resourcesPath(locale), current: page === 'resources' },
  { label: copy.contact, href: contactPath(locale), current: page === 'contact' },
];
---
<!doctype html>
<html lang={locale} dir={locale === 'fa' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#f7f4ed" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {locale === 'fa' && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
        <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700&display=swap" rel="stylesheet" />
      </>
    )}
    {locales.map((language) => <link rel="alternate" hreflang={language} href={pagePath(language)} />)}
    <link rel="alternate" hreflang="x-default" href={pagePath('en')} />
    <title>{pageTitle}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{copy.skip}</a>
    <header class="site-header container">
      <a class="wordmark" href={homePath(locale)} aria-label={artist.name} lang="en" dir="ltr">
        <span class="brand-symbol"><Icon name="music" /></span>
        <span class="brand-name">Armine<span class="brand-surname">SHAHNAZARIAN</span></span>
      </a>
      <nav class="desktop-nav" aria-label={copy.navigation}>
        {links.map((link) => <a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a>)}
      </nav>
      <nav class="language-switch" aria-label={copy.languages} dir="ltr">
        {locales.map((language) => <a href={pagePath(language)} lang={language} hreflang={language} aria-current={language === locale ? 'true' : undefined}>{language === 'en' ? 'EN' : languageNames[language]}</a>)}
      </nav>
      <details class="mobile-menu">
        <summary><span class="sr-only">{copy.menu}</span><span class="menu-lines" aria-hidden="true"></span></summary>
        <nav aria-label={copy.navigation}>
          {links.map((link) => <a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a>)}
        </nav>
      </details>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer container">
      <div><span class="footer-name" lang="en" dir="ltr">{artist.name}</span><p>{copy.footerNote}</p></div>
      <p class="copyright"><bdi>© {new Date().getFullYear()}</bdi> · {copy.footerRights}</p>
      <a href="#top" class="back-top">{copy.backTop}<Icon name="arrow" /></a>
    </footer>
    <script>
      document.querySelectorAll('.mobile-menu nav a').forEach((link) => {
        link.addEventListener('click', () => {
          const menu = link.closest('details');
          if (menu) menu.open = false;
        });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        document.querySelectorAll<HTMLDetailsElement>('.mobile-menu[open]').forEach((menu) => {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        });
      });
    </script>
  </body>
</html>
