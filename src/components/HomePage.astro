---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import { homeCopy, type Locale } from '../i18n/home';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = homeCopy[locale];
---
<Layout locale={locale}>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow"><span class="tiny-dot"></span>{copy.profession}</p>
      <h1 id="hero-title">{copy.heroStart}<br /><em>{copy.heroEnd}</em></h1>
      <p class="hero-intro">{copy.intro}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#teaching">{copy.primaryCta}<Icon name="arrow" /></a>
        <a class="text-link" href="#portfolio">{copy.secondaryCta}<span class="link-dot" aria-hidden="true"></span></a>
      </div>
      <p class="hero-note"><Icon name="wave" />{copy.heroNote}</p>
    </div>
    <figure class="hero-visual">
      <div class="photo-mat">
        <img class="hero-image" src="/images/piano-hero.webp" alt={copy.imageAlt} width="1024" height="1280" fetchpriority="high" />
        <figcaption class="photo-caption"><span class="caption-line"></span>{copy.imageCaption}</figcaption>
      </div>
      <div class="image-card"><span class="image-card-icon"><Icon name="music" /></span><div><strong>{copy.imageCardTitle}</strong><span>{copy.imageCardText}</span></div></div>
      <span class="hero-ornament" aria-hidden="true"><Icon name="spark" /></span>
    </figure>
  </section>
  <div class="music-strip container" aria-label={copy.eyebrow}>
    <span>{copy.stripOne}</span><Icon name="spark" /><span>{copy.stripTwo}</span><Icon name="spark" /><span>{copy.stripThree}</span>
  </div>
  <section class="about container section-space" aria-labelledby="about-title">
    <div class="about-copy"><p class="eyebrow">{copy.aboutLabel}</p><h2 id="about-title">{copy.aboutTitle}</h2><p>{copy.aboutText}</p><p>{copy.aboutSecond}</p><span class="signature" lang="en" dir="ltr">{copy.signature}</span></div>
    <aside class="quote-panel"><Icon name="spark" /><p class="eyebrow">{copy.quoteLabel}</p><blockquote>{copy.quote}</blockquote><div class="staff-lines" aria-hidden="true"><span>♪</span></div></aside>
  </section>
  <section id="teaching" class="teaching-section section-space" aria-labelledby="teaching-title">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">{copy.teachingLabel}</p><h2 id="teaching-title">{copy.teachingTitle}</h2><p>{copy.teachingText}</p></div>
      <div class="lesson-grid">
        {copy.lessons.map((lesson, index) => <article class="lesson-card"><div class="lesson-top"><span class="lesson-number">{lesson.number}</span><Icon name={index === 0 ? 'music' : index === 1 ? 'wave' : 'score'} /></div><h3>{lesson.title}</h3><p>{lesson.description}</p><details class="lesson-details"><summary>{copy.lessonDetail}<span aria-hidden="true">+</span></summary><p>{lesson.detail}</p></details></article>)}
      </div>
    </div>
  </section>
  <section id="portfolio" class="portfolio-section container section-space" aria-labelledby="portfolio-title">
    <div class="portfolio-copy"><p class="eyebrow">{copy.portfolioLabel}</p><h2 id="portfolio-title">{copy.portfolioTitle}</h2><p>{copy.portfolioText}</p><p class="availability"><span class="tiny-dot"></span>{copy.mediaSoon}</p></div>
    <div class="repertoire-grid"><article class="repertoire classical"><Icon name="music" /><div><h3>{copy.classical}</h3><p>{copy.classicalText}</p></div><span class="repertoire-line" aria-hidden="true"></span></article><article class="repertoire pop"><Icon name="wave" /><div><h3>{copy.pop}</h3><p>{copy.popText}</p></div><span class="repertoire-line" aria-hidden="true"></span></article></div>
  </section>
  <section id="resources" class="resources-section container" aria-labelledby="resources-title">
    <div><p class="eyebrow">{copy.resourcesLabel}</p><h2 id="resources-title">{copy.resourcesTitle}</h2><p>{copy.resourcesText}</p><p class="availability"><span class="tiny-dot"></span>{copy.resourcesSoon}</p></div>
    <ul class="resource-list"><li><Icon name="score" /><span>{copy.sheetMusic}</span></li><li><Icon name="book" /><span>{copy.practice}</span></li><li><Icon name="music" /><span>{copy.theory}</span></li></ul>
  </section>
  <section id="contact" class="contact-section section-space" aria-labelledby="contact-title">
    <div class="container contact-inner"><Icon name="spark" /><p class="eyebrow">{copy.contactLabel}</p><h2 id="contact-title">{copy.contactTitle}</h2><p>{copy.contactText}</p><span class="contact-status">{copy.contactSoon}</span></div>
  </section>
</Layout>
