---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import { homeCopy, homePath, type Locale } from '../i18n/home';
import { libraryCopy } from '../i18n/library';
import { performances, youtubeEmbedUrl } from '../content/media';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = libraryCopy[locale];
const home = homeCopy[locale];
---
<Layout locale={locale} page="about" title={copy.aboutTitle} description={copy.aboutDescription}>
  <section class="library-hero container" aria-labelledby="about-page-title">
    <p class="eyebrow hero-eyebrow"><span class="tiny-dot" aria-hidden="true"></span>{home.aboutLabel}</p>
    <h1 id="about-page-title">{copy.aboutHeading}<br /><em>{copy.aboutAccent}</em></h1>
    <p class="library-intro">{home.aboutText}</p>
    <a class="text-link" href="#performances">{copy.performancesLabel}<Icon name="arrow" /></a>
  </section>
  <section class="artist-story container" aria-labelledby="approach-title">
    <div class="artist-image">
      <img src="/images/piano-hero.webp" alt={home.imageAlt} width="1024" height="1280" loading="lazy" />
    </div>
    <div class="artist-approach">
      <p class="eyebrow">{copy.approach}</p>
      <h2 id="approach-title">{home.aboutTitle}</h2>
      <p>{copy.approachText}</p>
      <p>{home.aboutSecond}</p>
      <span class="signature" lang="en" dir="ltr">{home.signature}</span>
      <a class="text-link" href={homePath(locale) + '#teaching'}>{copy.lessonsLink}<Icon name="arrow" /></a>
    </div>
  </section>
  <section id="performances" class="media-section section-space" aria-labelledby="performances-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{copy.performancesLabel}</p>
        <h2 id="performances-title">{copy.performancesTitle}</h2>
        <p>{copy.performancesText}</p>
      </div>
      {performances.length ? (
        <div class="performance-grid">
          {performances.map((performance) => (
            <article class="performance-card" aria-labelledby={'video-' + performance.id}>
              {performance.kind === 'youtube' ? (
                <iframe
                  src={youtubeEmbedUrl(performance.videoId, locale)}
                  title={copy.youtubePlayer + ': ' + performance.title[locale]}
                  width="640"
                  height="360"
                  loading="lazy"
                  allow="encrypted-media; picture-in-picture; fullscreen"
                  allowfullscreen
                  referrerpolicy="strict-origin-when-cross-origin"
                ></iframe>
              ) : (
                <video controls playsinline preload="none" poster={performance.poster} aria-labelledby={'video-' + performance.id}>
                  <source src={performance.src} />
                  {performance.captions?.map((caption) => (
                    <track kind="captions" src={caption.src} srclang={caption.locale} label={caption.label} default={caption.locale === locale} />
                  ))}
                  <p>{copy.videoFallback}</p>
                </video>
              )}
              <div class="media-card-copy">
                <h3 id={'video-' + performance.id}>{performance.title[locale]}</h3>
                <p>{performance.description[locale]}</p>
                {performance.kind === 'youtube' ? (
                  <a class="text-link" href={'https://www.youtube.com/watch?v=' + performance.videoId}>{copy.watchOnYoutube}<span class="sr-only">: {performance.title[locale]}</span><Icon name="arrow" /></a>
                ) : (
                  <a class="text-link" href={performance.src} download>{copy.videoDownload}<span class="sr-only">: {performance.title[locale]}</span><Icon name="arrow" /></a>
                )}
                <details class="lesson-details">
                  <summary>{copy.transcript}<span aria-hidden="true">+</span></summary>
                  <p class="transcript-text">{performance.transcript[locale]}</p>
                </details>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="media-empty">
          <span class="contact-icon"><Icon name="music" /></span>
          <h3>{copy.videosEmptyTitle}</h3>
          <p>{copy.videosEmptyText}</p>
        </div>
      )}
    </div>
  </section>
</Layout>
