---
interface Props {
  name: 'arrow' | 'music' | 'spark' | 'book' | 'wave' | 'score';
  class?: string;
}
const { name, class: className } = Astro.props;
const paths = {
  arrow: ['M5 12h14', 'm13 6 6 6-6 6'],
  music: ['M9 18V5l11-2v13', 'M9 8l11-2', 'M9 18c0 1.7-1.8 3-4 3s-3-1.1-3-2.5S3.8 16 6 16c1.2 0 2.2.3 3 .8', 'M20 16c0 1.7-1.8 3-4 3s-3-1.1-3-2.5S14.8 14 17 14c1.2 0 2.2.3 3 .8'],
  spark: ['M12 2c0 7-3 10-10 10 7 0 10 3 10 10 0-7 3-10 10-10-7 0-10-3-10-10Z'],
  book: ['M12 6v15', 'M12 6C9 3 5 3 2 4v15c3-1 7-1 10 2 3-3 7-3 10-2V4c-3-1-7-1-10 2Z'],
  wave: ['M3 10v4', 'M7 6v12', 'M11 3v18', 'M15 7v10', 'M19 5v14', 'M23 10v4'],
  score: ['M3 5h18', 'M3 9h18', 'M3 13h18', 'M3 17h18', 'M15 17V3', 'M15 17c0 2-2 3-4 3s-3-1-3-2 2-3 4-3c1 0 2 .3 3 1'],
};
---
<svg class={className} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {paths[name].map((d) => <path d={d} />)}
</svg>
